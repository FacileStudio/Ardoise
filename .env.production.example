# Production Environment Variables for Ardoise

NODE_ENV=production

ENCRYPTION_SECRET=your-super-secret-encryption-key-min-32-chars

OIDC_ISSUER=https://sso.facile.studio
OIDC_CLIENT_ID=replace-with-the-registre-client-id
OIDC_CLIENT_SECRET=replace-with-the-registre-client-secret

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-real-postgres-password
POSTGRES_DB=ardoise

BACKEND_URL=https://backend-ardoise.facile.studio
FRONTEND_URL=https://ardoise.facile.studio
