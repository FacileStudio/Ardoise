# Production Environment Variables for Charles

DATABASE_URL=postgresql://user:password@host:5432/charles

NODE_ENV=production

ENCRYPTION_SECRET=your-super-secret-encryption-key-min-32-chars

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_strong_minio_password
MINIO_BUCKET_NAME=charles-uploads
MINIO_ENDPOINT=https://your-minio-endpoint.com
MINIO_PUBLIC_URL=https://your-minio-endpoint.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com

COMPANY_NAME=Facile Studio
COMPANY_ADDRESS=Your Company Address
COMPANY_CITY=75001 Paris, France
COMPANY_SIRET=123 456 789 00010
COMPANY_EMAIL=contact@facile.studio
COMPANY_PHONE=+33 1 23 45 67 89

FRONTEND_URL=https://your-frontend-domain.com
TRUSTED_ORIGINS=https://your-frontend-domain.com,https://your-backoffice-domain.com,https://your-api-domain.com

VITE_API_URL=https://your-api-domain.com/trpc

LOG_LEVEL=info
LOGTAIL_TOKEN=your_logtail_token_optional
