{
  "name": "@repo/backend",
  "license": "AGPL-3.0-only",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development LOG_PRETTY=1 bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external=* --minify",
    "start": "cd ../../packages/database && bunx prisma migrate deploy && cd ../../apps/backend && bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check-env": "bun ./src/lib/env.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@repo/database": "workspace:*",
    "@repo/glouton": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/plume": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@repo/types": "workspace:*",
    "@scalar/hono-api-reference": "0.10.19",
    "@trpc/server": "^11.28.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/stripe": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
