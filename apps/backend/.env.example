# PostgreSQL Database URL
# Run `bun run dev:db` to start and configure a local PostgreSQL instance
DATABASE_URL=postgresql://user@localhost:5432/monorepo_dev

NODE_ENV=development
PORT=3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

STORAGE_PATH=./data/uploads

ENCRYPTION_SECRET=change-me-min-32-chars-required

# Only when the web app and the API are on different subdomains of one base domain,
# so the auth cookie also reaches the web server (its /admin guard reads it).
# Leave unset for localhost or when /trpc is reverse-proxied under the web origin.
# COOKIE_DOMAIN=.ardoise.facile.studio

# Client magic link sign-in (all optional, defaults shown).
# MAGIC_LINK_TTL_MINUTES=15
# MAGIC_LINK_MAX_PER_EMAIL_HOUR=5
# MAGIC_LINK_MAX_PER_IP_HOUR=20

# Facile SSO. Staff sign in only through it; anyone who signs in is staff.
# Required in production. Clients never use it: they sign in with a magic link.
# OIDC_ISSUER=https://sso.facile.studio
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# Defaults: BACKEND_URL/auth/oidc/callback and FRONTEND_URL/login
# OIDC_REDIRECT_URL=http://localhost:3001/auth/oidc/callback
# OIDC_SUCCESS_URL=http://localhost:3000/login

# Logo for PDF receipts (optional - uses default if not specified)
# LOGO_PATH=/path/to/your/logo.png

# Discord webhook (optional)
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Nuage contract storage (optional, all three required together)
# Mint the token in Nuage: POST /api/users/me/api-token {"app":"ardoise","space_facile_ids":["fac_..."]}
# NUAGE_URL=https://nuage.facile.studio
# NUAGE_API_TOKEN=your_restricted_api_token
# NUAGE_SPACE_FACILE_ID=fac_000000000000000000000000
# NUAGE_SPACE_NAME=Ardoise

# Plume signature link (optional, all three required together)
# Webhook target in Plume: POST {BACKEND_URL}/webhooks/plume, signed with PLUME_WEBHOOK_SECRET
# PLUME_URL=https://plume.facile.studio
# PLUME_API_TOKEN=your_plume_api_token
# PLUME_WEBHOOK_SECRET=at_least_16_characters

# Glouton client sync (optional, all three required together)
# GLOUTON_API_TOKEN must equal Glouton's ARDOISE_API_TOKEN; GLOUTON_WEBHOOK_SECRET must equal Glouton's ARDOISE_WEBHOOK_SECRET
# GLOUTON_URL=https://glouton.facile.studio
# GLOUTON_API_TOKEN=shared_bearer_token
# GLOUTON_WEBHOOK_SECRET=at_least_16_characters

# Suite billing (optional). Only listed staff reach /admin/offres; empty means nobody.
# BILLING_STAFF_EMAILS=yann@facile.studio,noah@facile.studio,camille@facile.studio,mazouz@facile.studio
# Same value as Registre's; 32+ characters or the /billing/* routes stay disabled
# BILLING_API_TOKEN=
# BILLING_REDIRECT_ORIGINS=https://sso.facile.studio
# BILLING_SEED_ON_BOOT=false
