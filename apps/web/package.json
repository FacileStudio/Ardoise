{
  "name": "@repo/web",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "bun run scripts/build-icons.ts",
    "dev": "LOG_PRETTY=1 vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && NODE_OPTIONS='--max-old-space-size=8192' svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && eslint src"
  },
  "dependencies": {
    "@facile/muse": "github:FacileStudio/muse#v0.16.1",
    "@repo/admin": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/storage-client": "workspace:*",
    "@repo/trpc-client": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@sveltejs/adapter-node": "^5.5.8",
    "@trpc/client": "^11.28.0",
    "iconify-icon": "^3.0.5",
    "sveltekit-superforms": "^2.31.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^9.39.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
