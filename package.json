{
  "name": "ardoise",
  "license": "AGPL-3.0-only",
  "version": "0.20.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:db": "./scripts/start-db-dev.sh",
    "dev:db:setup": "./scripts/start-db-dev.sh && cd packages/database && bun run db:push",
    "db:studio": "cd packages/database && bun run db:studio",
    "db:seed": "cd packages/database && bun run db:seed",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-svelte": "^3.5.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.7",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "esbuild": "^0.28.1"
  }
}
