{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/browser.ts",
      "default": "./src/index.ts"
    },
    "./test-lock": "./src/test-lock.ts",
    "./zod": {
      "types": "./src/zod/index.ts",
      "default": "./src/zod/index.ts"
    }
  },
  "scripts": {
    "db:generate": "rm -rf src/zod && prisma generate && bun run scripts/patch-zod-types.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/pg": "^8.16.0",
    "pg": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3",
    "zod-prisma-types": "^3.3.11"
  }
}
