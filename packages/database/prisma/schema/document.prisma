enum DocumentType {
  prestation
  maintenance
  contrat_prestation
  contrat_maintenance
  back_contractuel
  appel_de_fonds
  prestation_barman
  prestation_design
  prestation_dev
  prestation_photo
  prestation_video
  prestation_formation
  prestation_btp
}

model Document {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type             DocumentType
  name             String
  invoiceNumber    String?
  quoteNumber      String?
  contractRef      String?

  clientName       String
  clientSiret      String?
  clientTvaIntracom String?
  clientAddress    String?
  clientCity       String?
  clientPostalCode String?
  clientCountry    String?

  providerId       String?
  provider         Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  providerName     String
  providerLegal    String?
  providerSiret    String?
  providerTvaIntracom String?
  providerLegalForm String?
  providerShareCapital Decimal? @db.Decimal(15, 2)
  providerRcsCity  String?
  providerApeCode  String?
  providerAddress  String?
  providerCity     String?
  providerPostalCode String?
  providerEmail    String?
  providerPhone    String?

  items            Json
  subtotal         Decimal  @db.Decimal(10, 2)
  tva              Decimal  @db.Decimal(10, 2)
  total            Decimal  @db.Decimal(10, 2)
  tvaRate          Int      @default(20)

  deliveryDate     DateTime?
  paymentTermsDays Int      @default(30)
  lateFeeRate      String   @default("3 fois le taux d'intérêt légal en vigueur")
  recoveryFeeAmount Decimal @db.Decimal(10, 2) @default(40)
  vatExemptionMention String?

  railwayEstimate  Decimal? @db.Decimal(10, 2)

  serviceData      Json?

  pdfUrl           String?
  pdfHash          String?
  fileSize         Int?

  createdBy        String
  createdByUser    User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  spaceId          String?
  space            Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  paymentAttachments PaymentDocument[]

  @@index([createdBy])
  @@index([type])
  @@index([createdAt])
  @@index([providerId])
  @@index([clientName])
  @@index([spaceId])
}
