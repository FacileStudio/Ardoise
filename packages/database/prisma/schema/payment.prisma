enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentFrequency {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum PaymentCollectionMethod {
  STRIPE
  MANUAL
}

model Payment {
  id String @id @default(cuid())

  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)
  stripeFee Decimal @db.Decimal(10, 2) @default(0)
  totalWithFees Decimal @db.Decimal(10, 2)
  description String
  status PaymentStatus @default(PENDING)
  frequency PaymentFrequency @default(ONE_TIME)
  collectionMethod PaymentCollectionMethod @default(STRIPE)
  reference String?

  dueDate DateTime
  paidAt DateTime?

  stripePaymentIntentId String? @unique
  stripeSubscriptionId String? @unique

  attachedFiles String[]

  attachedDocuments PaymentDocument[]

  receiptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([collectionMethod])
  @@index([stripePaymentIntentId])
}

model PaymentDocument {
  id String @id @default(cuid())

  paymentId  String
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  attachedAt DateTime @default(now())

  @@unique([paymentId, documentId])
  @@index([paymentId])
  @@index([documentId])
}
