enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  PAST_DUE
  FAILED
}

enum PaymentFrequency {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum PaymentCollectionMethod {
  STRIPE
  MANUAL
}

enum PaymentInvoiceStatus {
  PAID
  FAILED
}

model Payment {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  missionId String?
  mission      Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  amount           Decimal                 @db.Decimal(10, 2)
  stripeFee        Decimal                 @default(0) @db.Decimal(10, 2)
  totalWithFees    Decimal                 @db.Decimal(10, 2)
  description      String
  status           PaymentStatus           @default(PENDING)
  frequency        PaymentFrequency        @default(ONE_TIME)
  collectionMethod PaymentCollectionMethod @default(STRIPE)
  reference        String?

  dueDate DateTime
  paidAt  DateTime?

  stripePaymentIntentId String? @unique
  stripeSubscriptionId  String? @unique
  stripeInvoiceId       String?

  attachedFiles String[]

  attachedDocuments PaymentDocument[]
  invoices          PaymentInvoice[]

  receiptUrl      String?
  receiptAttempts Int     @default(0)
  receiptError    String?

  lastReminderSentAt DateTime?
  reminderCount      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([collectionMethod])
  @@index([stripePaymentIntentId])
  @@index([spaceId])
  @@index([missionId])
  @@index([documentId])
}

model PaymentInvoice {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  stripeInvoiceId String               @unique
  amount          Decimal              @db.Decimal(10, 2)
  status          PaymentInvoiceStatus
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

model PaymentDocument {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  attachedAt DateTime @default(now())

  @@unique([paymentId, documentId])
  @@index([paymentId])
  @@index([documentId])
}
