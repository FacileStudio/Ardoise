model Settings {
  id String @id @default("global")

  companyName String?
  companyLegal String?
  companyAddress String?
  companyCity String?
  companyCountry String @default("France")
  companySiret String?
  companyEmail String?
  companyPhone String?

  stripeSecretKey String?
  stripeWebhookSecret String?
  stripePublishableKey String?

  smtpHost String?
  smtpPort Int?
  smtpUser String?
  smtpPass String?
  smtpFrom String?

  docusealApiUrl String?
  docusealApiKey String?
  webhookUrl    String?
  webhookSecret String?
  webhookEvents String[] @default([])

  bankName String?
  iban String?
  bic String?

  logoUrl String?

  tvaRate Decimal @default(20) @db.Decimal(5, 2)

  nextInvoiceNumber Int @default(1)
  nextQuoteNumber Int @default(1)
  nextContractNumber Int @default(1)

  invoiceNumberFormat String @default("FAC-{{year}}-{{number}}")
  quoteNumberFormat String @default("DEVIS-{{year}}-{{number}}")
  contractNumberFormat String @default("CONT-{{year}}-{{number}}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
